  8+  818A              ; PRINTAT - Print a string in a position and attributes as per registers:
  9+  818A              ;		IN	A	: Bit 7=1 For Flash / Bit 6=1 For Brigh / Bit 5,4,3 for Paper / Bit 2,1,0 for Ink
 10+  818A              ;		IN	B	: Row 0..23
 11+  818A              ;		IN	C	: Column 0..31
 12+  818A              ;		IN	IX	: Address of text (Text must end in a 0)
 13+  818A              ; ----------------------------------------------------------------------------------------
 14+  818A CD 99 81     PRINTAT:	call PREP_PRT				; Update Attribute var &Screen & Attributes pointers
 15+  818D              ; ----------------------------------------------------------------------------------------
 16+  818D              ;		VVV Do not move PRINTSTR below as PRINTAT continues into PRINTSTR routine
 17+  818D              ; ----------------------------------------------------------------------------------------
 18+  818D              ; PRINTSTR - Prints String - IX Points to the String start
 19+  818D              ; ----------------------------------------------------------------------------------------
 20+  818D DD 7E 00     PRINTSTR:   ld a, (ix)					; A Contains first char to print
 21+  8190 B7           			or a						; check for end of string (0)
 22+  8191 C8           			ret z						; Finish printing if 0
 23+  8192 CD C7 81     			call PRINTCHNUM
 24+  8195 DD 23        			inc ix						; Move to next char in string
 25+  8197 18 F4        			jr PRINTSTR					; Start over printing sequence
