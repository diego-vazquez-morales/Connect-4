 49   805A              Coor_Atrib:
 50   805A                                      ; Rutina que recibe en B,C las coordenadas de la pantalla (fila, columna)
 51   805A                                      ; y devuelve en HL la dirección del atributo correspondiente
 52   805A F5               PUSH AF             ; Guardamos A en el stack
 53   805B C5               PUSH BC             ; Guardamos BC en el stack
 54   805C 60               LD H,b              ; Los bits 4,5 de B deben ser los bits 0,1 de H
 55   805D CB 3C            SRL H
 55   805F CB 3C          SRL H
 55   8061 CB 3C          SRL H
 56   8063 78               LD A,B              ; Los bits 0,1,2 de B deben ser los bits 5,6,7 de L
 57   8064 CB 27            SLA A
 57   8066 CB 27          SLA A
 57   8068 CB 27          SLA A
 57   806A CB 27          SLA A
 57   806C CB 27          SLA a
 58   806E B1               OR c                ; Y C son los bits 0-4 de L
 59   806F 6F               LD L,A
 60   8070 01 00 58         LD BC, $5800        ; Le sumamos la dirección de comienzo de los atributos
 61   8073 09               ADD HL,BC
 62   8074 C1               POP BC              ; Restauramos los valores del stack
 63   8075 F1               POP AF
 64   8076 C9               RET
 65   8077
 66   8077              Teclado:                ; Rutina para leer del teclado 'S' o 'N'
 67   8077 C5               PUSH BC             ; BC al stack para preservar su valor
 68   8078              T_N:
 69   8078 01 FE 7F         LD BC,$7FFE         ; Escanear línea B,N,M,SYMB,Space
 70   807B ED 78            IN A,(C)
 71   807D CB 5F            BIT 3,A
 72   807F 20 04            JR NZ,T_S           ; Han pulsado N
 73   8081 3E 4E            LD A,'N'
 74   8083 18 0B            JR T_F
 75   8085              T_S:
 76   8085 01 FE FD         LD BC,$FDFE         ; Escanear línea G,F,D,S,A
 77   8088 ED 78            IN A,(C)
 78   808A CB 4F            BIT 1,A
 79   808C 20 EA            JR NZ,T_N           ; No han pulsado 'S'
 80   808E 3E 53            LD A,'S'
 81   8090              T_F:
 82   8090 32 E4 80         LD (Caracter),A     ; Guardo 'S' o 'N' en la Variable Caracter
 83   8093              Soltar_Tecla:           ; Rutina de espera hasta que se suelta la tecla
 84   8093 ED 78            IN A,(C)            ; Leer del puerto que se ha definido en Lee_Tecla
 85   8095 E6 1F            AND $1F
 86   8097 FE 1F            CP $1F              ; Comprobar que no hay tecla pulsada
 87   8099 20 F8            JR NZ,Soltar_Tecla  ; esperar hasta que no haya tecla pulsada
 88   809B C1               POP BC              ; Recuperamos el valor de BC
 89   809C C9               RET
