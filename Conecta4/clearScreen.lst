 1    0000 F5               push af
 1    0001 E5             push hl
 2    0002              clear_screen:
 3    0002 21 00 58         ld hl, $5800
 4    0005 06 00            ld b, 0*8 + 0  ; A = PAPER * 8 + INK
 5    0007              bucle_clear:
 6    0007 70               ld (hl), b
 7    0008 23               inc hl
 8    0009 7C               ld a, h
 9    000A FE 5B            cp $5b
10    000C 20 F9            jr nz, bucle_clear
11    000E 28 00            jr z, fin_clear
12    0010              fin_clear:
13    0010 E1               pop hl
13    0011 F1             pop af
14    0012 C9               ret
15    0013
16    0013
