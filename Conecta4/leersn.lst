 1    0000 C5               push bc
 2    0001 D5               push de
 3    0002
 4    0002              S_N:
 5    0002 0E FE            ld c, $fe
 6    0004
 7    0004              ; Buscar tecla 'S'
 8    0004 06 FD            ld b, $fd
 9    0006 ED 78            in a, (c)       ; Leer puerto $fdfe (tecla 'S')
10    0008 CB 4F            bit 1, a        ; Comprobar bit 1 (tecla 'S')
11    000A 28 0A            jr z, tecla_S   ; Si está presionada (bit=0), saltar a tecla_S
12    000C
13    000C              ; Buscar tecla 'N'
14    000C 06 7F            ld b, $7f
15    000E ED 78            in a, (c)       ; Leer puerto $7ffe (tecla 'N')
16    0010 CB 5F            bit 3, a        ; Comprobar bit 3 (tecla 'N')
17    0012 28 0F            jr z, tecla_N   ; Si está presionada, saltar a tecla_N
18    0014
19    0014              ; Si no se presiona ninguna, volver a buscar
20    0014 18 EC            jr S_N
21    0016
22    0016              tecla_S:
23    0016 16 53            ld d, 'S'       ; Guardar 'S' en D
24    0018                  ; Esperar a que se libere la tecla 'S'
25    0018 06 FD            ld b, $fd       ; Puerto para 'S'
26    001A              espera_liberar_S:
27    001A ED 78            in a, (c)       ; Leer puerto $fdfe
28    001C CB 4F            bit 1, a        ; Comprobar bit 1 (tecla 'S')
29    001E 28 FA            jr z, espera_liberar_S ; Mientras esté presionada (bit=0), esperar
30    0020                  ; Ahora se liberó
31    0020 7A               ld a, d         ; Cargar 'S' en A para retornar
32    0021 18 0B            jr fin_SN
33    0023
34    0023              tecla_N:
35    0023 16 4E            ld d, 'N'       ; Guardar 'N' en D
36    0025                  ; Esperar a que se libere la tecla 'N'
37    0025 06 7F            ld b, $7f       ; Puerto para 'N'
38    0027              espera_liberar_N:
39    0027 ED 78            in a, (c)       ; Leer puerto $7ffe
40    0029 CB 5F            bit 3, a        ; Comprobar bit 3 (tecla 'N')
41    002B 28 FA            jr z, espera_liberar_N ; Mientras esté presionada, esperar
42    002D                  ; Ahora se liberó
43    002D 7A               ld a, d         ; Cargar 'N' en A para retornar
44    002E
45    002E              fin_SN:
46    002E D1               pop de
47    002F C1               pop bc
48    0030 C9               ret
